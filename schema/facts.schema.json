{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KEEP/KILL opportunity facts",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "url", "track", "prize", "deadline_local", "deadline_tz", "eligibility", "deliverables", "ai_tools_allowed", "notes"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "url": {"type": "string", "minLength": 1},
    "track": {"type": "string", "minLength": 1},
    "prize": {"type": "string", "minLength": 1},
    "deadline_local": {"type": "string", "minLength": 1, "description": "YYYY-MM-DD HH:MM, or INCONNU when missing"},
    "deadline_tz": {"type": "string", "minLength": 1, "description": "IANA timezone, or INCONNU when missing"},
    "eligibility": {"type": "string", "minLength": 1},
    "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "ai_tools_allowed": {"type": "string", "enum": ["yes", "no", "silent"]},
    "notes": {"type": "string", "minLength": 1}
  }
}
